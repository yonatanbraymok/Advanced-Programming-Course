# Copy to .env and adjust for local development (do not commit .env!!!!!).
# Docker Compose loads .env for the web service; override host/port in compose for containers.

# Web server (Node.js + Express)
PORT=3000

# Exercise 2 TCP recommender (C++ server)
EX2_SERVER_HOST=127.0.0.1
EX2_SERVER_PORT=8080

# JWT signing (required for login and protected routes)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
